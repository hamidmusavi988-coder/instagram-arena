# Server-only variables. Never commit .env or .env.local with real credentials.
# On Vercel, add these in Project Settings > Environment Variables.

# Neon/hosted PostgreSQL: pooled URL for the app, direct URL for Drizzle.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Stable production HTTPS origin, without a trailing slash.
APP_URL=

# Connect a PUBLIC Vercel Blob store. Required for uploads on Vercel.
# The SDK's client-token upload flow needs the read/write token, even if
# Vercel also supplies OIDC/Blob store environment variables.
BLOB_READ_WRITE_TOKEN=

# Recommended for low-latency messaging across Vercel instances.
# All four values must come from the same Pusher CHANNELS app (not Beams).
# Only the public key and cluster are sent to the authenticated browser.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# Optional: email/password sign-in works without Google credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: leave both keys unset to generate/persist one pair in PostgreSQL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Recommended on a fresh production DB: only real members and their content.
# Use true locally if you want the curated starter feed.
# This flag never deletes data that already exists.
SEED_DEMO_CONTENT=false
